# Copy to .env for docker-compose.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=job_matcher
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI / embeddings (apps/common/ai.py) -----------------------------------
# Leave OPENAI_API_KEY unset to run entirely in deterministic stub mode (no
# network calls, no cost, fully testable). Set it to switch get_embedding()
# and generate_answer() over to the real OpenAI API.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.6-sol

# --- Dev-only SQLite override (see config/settings/base.py) ----------------
# Never set this in docker-compose or production - Postgres+pgvector is the
# real backend. Useful for running manage.py locally without Docker/Postgres.
USE_SQLITE=False
